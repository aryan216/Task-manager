# Neon Postgres connection string. Put the real value in .env, not here.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Public URL of this Next.js app. The API client uses it.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ImageKit. Put the private key in .env, not here.
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
IMAGEKIT_PRIVATE_KEY=

# GitHub OAuth App. Callback URL: {NEXT_PUBLIC_APP_URL}/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
